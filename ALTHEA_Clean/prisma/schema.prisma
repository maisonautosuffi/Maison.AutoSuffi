// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MODEL
// ============================================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  password      String
  role          String    @default("CLIENT")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  projects      Project[]
  chatSessions  ChatSession[]
}

// Role values: CLIENT, ARCHITECT, ADMIN

// ============================================
// PROJECT MODEL
// ============================================
model Project {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Project Details
  name              String
  collection        String
  status            String        @default("PRE_STUDY")
  
  // Configuration from AI Chat
  desiredSurface    Int?          // m²
  hasTerrain        Boolean?
  terrainSurface    Int?
  orientation       String?
  budget            String?       // Stored as string to preserve formatting
  
  // Calculated Values
  estimatedCost     String?
  pricePerM2        String?
  
  // Timestamps
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  documents         Document[]
  chatSessions      ChatSession[]
}

// Collection values: SABLE, CUIVRE, INDIGO
// ProjectStatus values: PRE_STUDY, ARCHITECT_REVIEW, IN_CONSTRUCTION, COMPLETED

// ============================================
// CHAT SESSION MODEL
// ============================================
model ChatSession {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  messages      ChatMessage[]
  leads         Lead[]
}

model ChatMessage {
  id            String        @id @default(cuid())
  sessionId     String
  session       ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  sender        String
  content       String
  imageUrl      String?
  
  createdAt     DateTime      @default(now())
}

// Sender values: USER, AGENT

// ============================================
// DOCUMENT MODEL (Digital Twin)
// ============================================
model Document {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  name          String
  type          String
  url           String
  size          Int           // bytes
  mimeType      String
  
  uploadedAt    DateTime      @default(now())
}

// DocumentType values: PLAN, PHOTO, VIDEO, CONTRACT, INVOICE, OTHER

// ============================================
// LEAD MODEL (Prospects from Chat)
// ============================================
model Lead {
  id            String    @id @default(cuid())
  
  // Contact info
  email         String?
  phone         String?
  name          String?
  
  // Project details from chat
  model         String?
  collection    String?
  surface       Int?
  hasTerrain    Boolean?
  terrainSurface Int?
  orientation   String?
  budget        String?
  
  // Chat session reference
  chatSessionId String?
  chatSession   ChatSession? @relation(fields: [chatSessionId], references: [id])
  
  // Lead status
  status        String    @default("NEW") // NEW, CONTACTED, QUALIFIED, CONVERTED, LOST
  source        String    @default("WEBSITE")
  notes         String?
  generatedImages String? // JSON string of image URLs
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
